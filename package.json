{
  "name": "@primebrick/decimal",
  "version": "0.1.0",
  "description": "High-performance base-10 decimal arithmetic on native BigInt — exact, deterministic, PostgreSQL numeric-faithful. The missing ring between JS Number and SQL decimal.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24"
  },
  "author": "Michael Sogos",
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelsogos/primebrick-decimal"
  },
  "homepage": "https://github.com/michaelsogos/primebrick-decimal#readme",
  "bugs": {
    "url": "https://github.com/michaelsogos/primebrick-decimal/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "version:auto": "node scripts/version-sync.mjs",
    "prebuild": "node scripts/version-sync.mjs",
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "extract-docs": "typedoc"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@types/node": "24.13.3",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
